[Unit]
Description=Krisha Agent Docker Compose Stack
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__
# Rootless docker socket for the user the unit runs under (%U = uid).
Environment=DOCKER_HOST=unix:///run/user/%U/docker.sock
ExecStartPre=-/usr/bin/env docker compose -f __PROJECT_ROOT__/podman-compose.yml up -d postgres redis
ExecStartPre=/usr/bin/env bash __PROJECT_ROOT__/deploy/systemd/wait_for_datastores.sh __PROJECT_ROOT__/podman-compose.yml
ExecStartPre=/usr/bin/env docker compose -f __PROJECT_ROOT__/podman-compose.yml run --rm migrate
ExecStart=/usr/bin/env docker compose -f __PROJECT_ROOT__/podman-compose.yml up --remove-orphans
ExecStop=/usr/bin/env docker compose -f __PROJECT_ROOT__/podman-compose.yml down
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=120
ExecReload=/usr/bin/env docker compose -f __PROJECT_ROOT__/podman-compose.yml up -d --remove-orphans

[Install]
WantedBy=default.target
